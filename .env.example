# Database credentials
MONGODB_URI=mongodb://localhost:27017/vessels_db

# Application Security
AUTH_SECRET=vessel_library_super_secret_jwt_key_32bytes_minimum_length_required!

# Default Administrator Seed Account
ADMIN_FULL_NAME=Administrator
ADMIN_EMPLOYEE_ID=EMP000
ADMIN_EMAIL=admin@vessellibrary.com
ADMIN_PIN=1234
ADMIN_PASSWORD=admin1234password!

# Storage Configuration (Local static folder by default, extensible to AWS S3/Cloud)
IMAGE_STORAGE_PATH=/uploads
NEXT_PUBLIC_APP_URL=http://localhost:3000
